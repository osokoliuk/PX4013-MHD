cabal-version:   3.16
name:            cvpy
version:         0.1.0.0
license:         NONE
author:          osokoliuk
maintainer:      oleksii.sokoliuk@mao.kiev.ua
build-type:      Simple
extra-doc-files: CHANGELOG.md

common warnings
    ghc-options: -Wall -O2 -threaded -rtsopts

executable src
    import:           warnings
    main-is:          Main.hs
    build-depends:    base ^>=4.20.2.0, parallel, containers 
    hs-source-dirs:   app
    default-language: Haskell2010
